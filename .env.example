# ── Database ───────────────────────────────────────────────────
# SQLite — path is relative to the prisma/ directory
DATABASE_URL="file:./blog.db"

# ── Session ────────────────────────────────────────────────────
# Must be at least 32 characters. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="<generate-with-command-above>"

# ── Site ───────────────────────────────────────────────────────
# Update these for your deployment
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_BLOG_AUTHOR="Your Name"
